.brand {
  text-align: center;
  padding: 24rpx 0 20rpx;
}
.brand-logo {
  font-family: "Amiri", serif;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--ds-brand);
  line-height: 1.1;
}
.brand-sub {
  font-size: 24rpx;
  color: var(--ds-ink-2);
  letter-spacing: 0.12em;
  margin-top: 6rpx;
}

.daily {
  text-align: center;
  padding: 40rpx 32rpx;
}
.daily-label {
  font-size: 22rpx;
  color: var(--ds-gold);
  letter-spacing: 0.1em;
  margin-bottom: 20rpx;
}
.daily-cn {
  margin-top: 16rpx;
  font-size: 30rpx;
}
.daily-en {
  margin-top: 6rpx;
}

.stats {
  display: flex;
  margin-top: 24rpx;
  padding: 28rpx 0;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ds-brand);
  line-height: 1.1;
}
.stat-label {
  font-size: 22rpx;
  color: var(--ds-ink-3);
  margin-top: 8rpx;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-line);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
}
.entry-ic {
  font-size: 44rpx;
}
.entry-tx {
  display: flex;
  flex-direction: column;
}
.entry-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-ink);
}
.entry-d {
  font-size: 22rpx;
  color: var(--ds-ink-3);
  margin-top: 4rpx;
}
