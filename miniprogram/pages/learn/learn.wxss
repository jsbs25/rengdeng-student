.head { padding: 8rpx 4rpx 20rpx; }
.head-title { font-size: 40rpx; font-weight: 700; color: var(--ds-ink); }
.head-sub { font-size: 24rpx; color: var(--ds-ink-3); margin-top: 6rpx; }

.cats { white-space: nowrap; margin-bottom: 8rpx; }
.cats .chip { display: inline-block; }

.toolbar { margin: 8rpx 0 12rpx; }
.tb-btn { width: 100%; }

.sentence-list { margin-top: 12rpx; }
.s-card {
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-line);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 14rpx;
}
.s-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.s-ar { flex: 1; }
.collect {
  flex: none;
  color: var(--ds-brand);
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--ds-line);
  border-radius: 999rpx;
}
.s-cn { margin-top: 12rpx; font-size: 28rpx; }
.s-en { margin-top: 4rpx; }

/* 闪卡 */
.flash { padding: 40rpx 0; }
.flash-card {
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-line);
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.flash-cn { margin-top: 28rpx; font-size: 32rpx; }
.flash-en { margin-top: 8rpx; }
.flash-hint { margin-top: 40rpx; }
.flash-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.flash-actions button { flex: 1; }
.flash-progress {
  text-align: center;
  color: var(--ds-ink-3);
  font-size: 24rpx;
  margin-top: 20rpx;
}
