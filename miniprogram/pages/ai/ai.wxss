.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.msg-list {
  flex: 1;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  overflow-y: auto;
}
.msg {
  display: flex;
  margin-bottom: 20rpx;
}
.msg.user {
  justify-content: flex-end;
}
.msg.bot {
  justify-content: flex-start;
}
.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.msg.user .bubble {
  background: var(--ds-brand);
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.msg.bot .bubble {
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-line);
  color: var(--ds-ink);
  border-bottom-left-radius: 6rpx;
}
.typing {
  color: var(--ds-ink-3);
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--ds-surface);
  border-top: 1rpx solid var(--ds-line);
}
.input {
  flex: 1;
  background: var(--ds-surface-2);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
}
.send {
  background: var(--ds-brand);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 30rpx;
  line-height: 64rpx;
}
.send::after { border: none; }
