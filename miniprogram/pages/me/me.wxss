.profile {
  text-align: center;
  padding: 40rpx;
}
.profile-sub {
  margin-top: 8rpx;
}

.stat-grid {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ds-brand);
}
.stat-label {
  font-size: 22rpx;
  color: var(--ds-ink-3);
  margin-top: 6rpx;
}

.word {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ds-line);
}
.word:last-child { border-bottom: none; }
.word-main { flex: 1; min-width: 0; }
.word-cn { margin-top: 4rpx; font-size: 24rpx; color: var(--ds-ink-2); }
.word-del {
  flex: none;
  color: var(--ds-ink-3);
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--ds-line);
  border-radius: 999rpx;
}

.device {
  margin-top: 16rpx;
  word-break: break-all;
  line-height: 1.6;
}
.about {
  line-height: 1.8;
  margin-bottom: 16rpx;
}
.copy {
  width: 100%;
}
