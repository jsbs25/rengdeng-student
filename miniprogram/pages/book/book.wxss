.read {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 80rpx;
}
.read-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ds-line);
}
.read-back {
  color: var(--ds-brand);
  font-size: 28rpx;
}
.read-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-ink);
  flex: 1;
  text-align: center;
}
.read-body {
  font-size: 40rpx;
  line-height: 2.1;
  color: var(--ds-ink);
  padding-top: 32rpx;
}

.toc {
  padding: 24rpx 28rpx 60rpx;
}
.toc-head {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ds-ink);
}
.toc-author {
  font-size: 24rpx;
  color: var(--ds-gold);
  margin-top: 8rpx;
}
.toc-intro {
  font-size: 24rpx;
  color: var(--ds-ink-2);
  line-height: 1.7;
  margin: 16rpx 0 24rpx;
  padding: 20rpx;
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-line);
  border-radius: 12rpx;
}
.chapter {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--ds-line);
}
.chapter-num {
  color: var(--ds-ink-3);
  font-size: 24rpx;
}
.chapter-t {
  font-size: 30rpx;
  color: var(--ds-ink);
}
