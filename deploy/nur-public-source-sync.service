[Unit]
Description=Nour bounded public Arabic source metadata refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/nur
ExecStart=/usr/bin/python3 /opt/nur/harvest/public_source_sync.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/nur/data/public_source_cache
